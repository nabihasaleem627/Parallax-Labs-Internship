{
  "name": "bookflow-saas-platform",
  "private": true,
  "version": "3.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "db:generate": "npm run prisma:generate -w server",
    "db:migrate": "npm run prisma:migrate -w server",
    "db:seed": "npm run prisma:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
