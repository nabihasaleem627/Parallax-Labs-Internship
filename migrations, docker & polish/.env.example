# Copy this file to .env for local development, or to .env for use with
# docker-compose (docker-compose.yml also reads this file). Never commit a
# real .env file with real secrets.

# --- Application (used directly by Next.js) ---------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development

# --- Docker Compose only (used to template the postgres/redis containers) ---
# These are consumed by docker-compose.yml to build the DATABASE_URL/REDIS_URL
# above when running the full containerized stack. Change POSTGRES_PASSWORD
# before deploying anywhere beyond local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=3000

# Optional: override the number of synthetic rows created by `npm run db:seed`
SEED_BULK_COUNT=100000
