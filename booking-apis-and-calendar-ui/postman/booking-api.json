    {
      "name": "Create Booking (with Idempotency-Key)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
            "description": "Unique UUID v4 to guarantee request idempotency across retries"
          },
          {
            "key": "x-tenant-slug",
            "value": "{{tenantSlug}}",
            "description": "Tenant organization slug for multi-tenant isolation"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Eleanor Vance\",\n  \"customerEmail\": \"eleanor.vance@example.com\",\n  \"customerPhone\": \"+1 (555) 987-6543\",\n  \"serviceName\": \"Initial Health Consultation\",\n  \"bookingDate\": \"2026-10-15\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"10:00\",\n  \"status\": \"CONFIRMED\",\n  \"notes\": \"Follow-up consult regarding initial scan results.\",\n  \"price\": 150\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bookings"]
        },
        "description": "Creates a new booking slot. Evaluates conflict intervals and stores response in idempotency cache."
      },
      "response": [
        {
          "name": "201 Created (Success)",
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"cm1q2w3e4r5t6y7u8\",\n    \"tenantId\": \"cuid_acme_wellness\",\n    \"customerName\": \"Eleanor Vance\",\n    \"customerEmail\": \"eleanor.vance@example.com\",\n    \"customerPhone\": \"+1 (555) 987-6543\",\n    \"serviceName\": \"Initial Health Consultation\",\n    \"bookingDate\": \"2026-10-15T00:00:00.000Z\",\n    \"startTime\": \"09:00\",\n    \"endTime\": \"10:00\",\n    \"status\": \"CONFIRMED\",\n    \"notes\": \"Follow-up consult regarding initial scan results.\",\n    \"price\": 150,\n    \"createdAt\": \"2026-09-27T08:00:00.000Z\",\n    \"updatedAt\": \"2026-09-27T08:00:00.000Z\"\n  }\n}"
        },
        {
          "name": "409 Conflict (Double-Booking Error)",
          "status": "Conflict",
          "code": 409,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"BOOKING_CONFLICT\",\n    \"message\": \"This time slot is already booked.\"\n  }\n}"
        },
        {
          "name": "400 Validation Error",
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"Invalid booking data\",\n    \"details\": [\n      {\n        \"field\": \"endTime\",\n        \"message\": \"End time must be after start time\"\n      }\n    ]\n  }\n}"
        }
      ]
    },
