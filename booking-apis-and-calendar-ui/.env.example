# Database connection string (PostgreSQL - Neon, Supabase, Railway, Vercel Postgres, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_booking?schema=public"

# Authentication secret for signing session tokens (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-characters"

# Base URL of the application
NEXTAUTH_URL="http://localhost:3000"
