# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection string. The application connects with a NON-OWNER
# database role (tenant_app) so that PostgreSQL Row-Level Security policies
# are always enforced. See README -> "Multi-Tenant Strategy".
DATABASE_URL="postgresql://tenant_app:tenant_app_dev_password@localhost:5432/bookflow?schema=public"

# Owner-role connection string used by the Prisma CLI for migrations and
# seeding only. It is never used by the application at runtime.
# On Vercel, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bookflow?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign session JWTs. Minimum 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-64-character-secret"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute base URL of this deployment (used for links such as password
# reset emails). Local: http://localhost:3000 | Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
